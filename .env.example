# Postgres connection string. On Vercel, add the Vercel Postgres (or Neon/Supabase)
# integration and copy the connection string it gives you here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Signal "missed weigh-in" nudge (optional) ---
# See signal-bridge/README.md for how to stand up the signal-cli-rest-api
# service and get these values. All four are required for the daily nudge
# cron (src/app/api/cron/nudge) to actually send anything; if unset, it
# just fails closed (401) and does nothing.

# URL of your self-hosted signal-cli-rest-api instance (e.g. a Fly.io app).
SIGNAL_API_URL="https://your-app.fly.dev"

# The phone number your signal-cli instance is linked/registered as, in
# E.164 format (e.g. "+15551234567").
SIGNAL_SENDER_NUMBER="+15551234567"

# Where to send the nudge: a Signal group's internal ID (starts with
# "group.") or a plain phone number for a 1:1 chat.
SIGNAL_RECIPIENT="group.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# IANA timezone used to decide "today" for the nudge — there's no browser
# to correct to for a scheduled job, unlike the rest of the app.
NUDGE_TIMEZONE="Pacific/Auckland"

# Shared secret Vercel Cron sends back to prove the request is really from
# your scheduled job, not a random visitor hitting the URL. Generate with:
#   openssl rand -base64 32
# Set this as an environment variable in Vercel — Cron Jobs automatically
# send it as "Authorization: Bearer <value>".
CRON_SECRET="replace-with-a-long-random-string"
