# Postgres connection string. On Vercel, add the Vercel Postgres (or Neon/Supabase)
# integration and copy the connection string it gives you here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Bearer token for one-off admin actions (currently: POST /api/admin/backfill-badges).
# Generate one with: openssl rand -base64 32
ADMIN_SECRET="replace-with-a-long-random-string"
