generator client {
  provider   = "prisma-client-js"
  // Rust-free query compiler (WASM) + a JS Postgres driver via @prisma/adapter-pg.
  // Drops the ~20 MB native query engine from every cold start on Vercel.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  fullName     String       @unique
  passwordHash String
  unit         String       @default("kg")
  hideWeight   Boolean      @default(false)
  // Target % weight loss the user set for themselves (e.g. 10 = "lose 10%").
  // This is the canonical value used everywhere (ranking, badges, the
  // leaderboard ring) — null means no goal set. When the goal was entered
  // as a target weight, goalWeight holds that raw value (in the user's
  // unit, at the time it was set) purely so Settings can redisplay it;
  // goalPercent is derived from it once, against the user's first
  // weigh-in, and stays the source of truth from then on.
  goalPercent  Float?
  goalWeight   Float?
  // In the user's own linear unit — cm when unit="kg", inches when
  // unit="lbs" — converted alongside weight/goalWeight on a unit switch.
  // Null means not set (no BMI can be shown until it is).
  height       Float?
  hideBMI      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  weighIns     WeighIn[]
  badges       UserBadge[]
  dailyVisits  DailyVisit[]

  // Snapshot of every competitor's badge count as of this user's last
  // leaderboard view — { [userId]: badgeCount } — used to glow/pulse a
  // row's badge count when it's changed since they last looked.
  lastSeenBadgeCounts Json @default("{}")
}

model WeighIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weight    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Earned achievements. badgeId matches a static definition in
// src/lib/badges/definitions.ts — there's no Badge table since the set of
// possible badges is fixed in code, not user-editable.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// One row per user per calendar day they were active on any authenticated
// page — powers the sign-in-streak badges, distinct from WeighIn dates
// (which track when they actually logged a weight).
model DailyVisit {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@unique([userId, date])
}
